PREFIX rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs:  <http://www.w3.org/2000/01/rdf-schema#>
PREFIX kg:    <https://kozaki-lab.jp/REFV-KG/data/>
PREFIX cls:   <https://kozaki-lab.jp/REFV-KG/class/>
PREFIX prop:  <https://kozaki-lab.jp/REFV-KG/prop/>

SELECT DISTINCT ?oClass ?o
WHERE {
  GRAPH ?g {
    ?s ?p ?o .
    VALUES ?p { prop:cause prop:effect prop:countermeasure }
    OPTIONAL{
      ?o a ?oClass .
      OPTIONAL{ ?oClass rdfs:label ?oClassLabel . }
    }
  }
}
ORDER BY ?oClass