PREFIX rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs:  <http://www.w3.org/2000/01/rdf-schema#>
PREFIX kg:    <https://kozaki-lab.jp/REFV-KG/data/>
PREFIX cls:   <https://kozaki-lab.jp/REFV-KG/class/>
PREFIX prop:  <https://kozaki-lab.jp/REFV-KG/prop/>

SELECT DISTINCT ?stc ?stcLabel
WHERE {
  GRAPH ?g {
    ?s ?p ?o .
    << ?s ?p ?o >> prop:relatedOpinion ?opinion .
    VALUES ?p { prop:cause prop:effect prop:countermeasure }
    ?opinion prop:speaker ?st .
    OPTIONAL {
      ?st a ?stc .
      OPTIONAL {
        ?stc rdfs:label ?stcLabel .
      }
    }
  }
}
ORDER BY ?stc