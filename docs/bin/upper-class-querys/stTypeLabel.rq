PREFIX rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs:  <http://www.w3.org/2000/01/rdf-schema#>
PREFIX kg:    <https://kozaki-lab.jp/REFV-KG/data/>
PREFIX cls:   <https://kozaki-lab.jp/REFV-KG/class/>
PREFIX prop:  <https://kozaki-lab.jp/REFV-KG/prop/>

SELECT DISTINCT  ?stClass ?stClassLabel ?stType ?stTypeLabel
WHERE {
  GRAPH ?g {
    << ?s ?p ?o >> prop:relatedOpinion ?opinion .
    VALUES ?p { prop:cause prop:effect prop:countermeasure }
    ?opinion prop:speaker ?stakeholder .
    ?stakeholder a ?stClass .
    OPTIONAL{ ?stClass rdfs:label ?stClassLabel . }
  }
  OPTIONAL{
    ?stClass rdfs:subClassOf ?stType.
    OPTIONAL{ ?stType rdfs:label ?stTypeLabel . }
  }
}
ORDER BY ?stClass
